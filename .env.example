# ---- Required -------------------------------------------------------------
# Bot token from https://discord.com/developers/applications  (never commit the real value)
DISCORD_TOKEN=
# Application (client) ID - needed by `npm run deploy-commands`
DISCORD_CLIENT_ID=
# Directory for state.json (identifiers, countries, settings, cooldowns, ignores). MOUNT IT AS A VOLUME in production.
STATE_DIR=./state

# ---- Strongly recommended -------------------------------------------------
# Restrict the bot to one server. Commands register instantly there, and interactions from other servers are refused.
DISCORD_GUILD_ID=
# Comma-separated extra users / roles allowed to run configuration commands
# (members with the Discord "Administrator" permission are always allowed).
AUTHORIZED_USER_IDS=
ADMIN_ROLE_IDS=

# ---- GeoFS data source ----------------------------------------------------
# Read-only multiplayer map endpoint used by the in-game player map (see docs/GEOFS_INVESTIGATION.md)
GEOFS_API=https://mps.geo-fs.com/map
# Page that embeds the aircraft id -> name table
GEOFS_AIRCRAFT_LIST_URL=https://www.geo-fs.com/geofs.php
# Poll period. GeoFS's own client polls /map every 10 s. Minimum 5000.
POLL_INTERVAL_MS=10000
# Ignore aircraft whose last server timestamp is older than this
STALE_AFTER_MS=120000
HTTP_TIMEOUT_MS=15000

# ---- Osprey V2 identity enrichment (optional) -----------------------------
# Endpoints taken from the cynkcrl-ux/GeoFS-MRP-Track- reference bot: /users/?acid=, /users/search?exact_callsign=, /users/search?pattern=
OSPREY_BASE=https://api.gms-admin.net/api/v2
# Set false to turn the integration off (alerts and /ident /roster then work without it)
OSPREY_ENABLED=true

# ---- Runtime --------------------------------------------------------------
HEALTH_PORT=8080
LOG_LEVEL=info
# Human-readable logs (development only; requires devDependencies)
LOG_PRETTY=false
# Register/refresh slash commands on start (idempotent). Set false to use `npm run deploy-commands` manually.
REGISTER_COMMANDS=true
