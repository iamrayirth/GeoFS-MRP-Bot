{
  "name": "geofs-mrp-bot",
  "version": "1.0.0",
  "description": "Discord bot that monitors live GeoFS multiplayer aircraft and alerts when matching aircraft enter configured countries (incl. territorial waters).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy-commands": "node dist/discord/deploy-commands.js",
    "build:geodata": "tsx scripts/build-geodata.ts",
    "update:aircraft": "tsx scripts/update-aircraft-types.ts",
    "dry-run": "tsx scripts/live-dry-run.ts",
    "probe:geofs": "tsx scripts/probe-geofs.ts",
    "deploy-commands:dev": "tsx src/discord/deploy-commands.ts"
  },
  "dependencies": {
    "@turf/bbox": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.9",
    "i18n-iso-countries": "^7.14.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "mapshaper": "^0.7.101",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
